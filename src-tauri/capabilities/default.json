{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default desktop permissions for DBStudio",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "process:allow-exit",
    "process:allow-restart",
    "updater:allow-check",
    "updater:allow-download-and-install"
  ]
}
